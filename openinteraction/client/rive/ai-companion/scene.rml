<Rive version="1" kind="fragment">
    <!--
      Openinteraction's interview companion.

      Public runtime contract (Companion view model):
      - mode: idle | listening | thinking | speaking | error
      - lookX/lookY: normalized gaze values from -1 to 1
      - react: one-shot interaction trigger

      React owns product state. This file owns drawing, motion, blending, and
      character reactions.
    -->
    <Artboard
        defaultStateMachineId="0:7"
        viewModelId="0:400"
        viewModelInstanceId="0:401"
        styleId="0:5"
        width="500"
        height="500"
        name="AI Companion"
        id="0:2"
    >
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- The reaction wrapper is animated independently from mode changes. -->
        <Node x="250" y="250" name="Reaction Root" id="0:20">
            <Node name="Character" id="0:21">
                <!-- Face details are declared first because Rive draws first siblings on top. -->
                <Node name="Gaze" id="0:29">
                    <DataBindContext sourcePathIds="0:400-0:411" propertyKey="13" converterId="0:600"/>
                    <DataBindContext sourcePathIds="0:400-0:412" propertyKey="14" converterId="0:601"/>

                    <Node y="8" name="Expression" id="0:30">
                        <Shape x="-48" name="Left eye glint">
                            <Ellipse width="8" height="10" originX="0.5" originY="0.5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FFFDFBF4" name="Color"/></Fill>
                        </Shape>
                        <Shape x="48" name="Right eye glint">
                            <Ellipse width="8" height="10" originX="0.5" originY="0.5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FFFDFBF4" name="Color"/></Fill>
                        </Shape>
                        <Shape x="-48" name="Left eye" id="0:31">
                            <Ellipse width="34" height="54" originX="0.5" originY="0.5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF11100D" name="Color"/></Fill>
                        </Shape>
                        <Shape x="48" name="Right eye" id="0:32">
                            <Ellipse width="34" height="54" originX="0.5" originY="0.5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF11100D" name="Color"/></Fill>
                        </Shape>
                    </Node>
                </Node>

                <Shape y="76" name="Mouth" id="0:40">
                    <Rectangle width="42" height="9" cornerRadiusTL="5" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF11100D" name="Color"/></Fill>
                </Shape>

                <Shape x="-79" y="-88" rotation="-0.45" opacity="0.64" name="Face highlight">
                    <Ellipse width="88" height="34" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color"/></Fill>
                </Shape>

                <Shape x="108" y="-96" name="Spark" id="0:60">
                    <Star points="4" innerRadius="0.36" width="34" height="34" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF0C419" name="Color"/></Fill>
                </Shape>

                <Shape name="Body" id="0:22">
                    <Ellipse width="310" height="310" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <LinearGradient startX="-118" startY="-128" endX="132" endY="136" name="Body gradient">
                            <GradientStop colorValue="FFFFFFFF" position="0"/>
                            <GradientStop colorValue="FFF4F0E5" position="0.56"/>
                            <GradientStop colorValue="FFD9CEA8" position="1"/>
                        </LinearGradient>
                    </Fill>
                    <Stroke thickness="4" name="Warm edge">
                        <SolidColor colorValue="66F0C419" name="Color"/>
                    </Stroke>
                </Shape>

                <Shape opacity="0.34" name="Inner glow">
                    <Ellipse width="278" height="278" originX="0.5" originY="0.5" name="Path"/>
                    <Stroke thickness="3" name="Stroke"><SolidColor colorValue="99FFFFFF" name="Color"/></Stroke>
                </Shape>

                <Shape y="18" opacity="0.18" name="Soft shadow">
                    <Ellipse width="330" height="330" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="AAE0A900" name="Color"/></Fill>
                </Shape>

                <Shape opacity="0.32" name="Aura inner" id="0:50">
                    <Ellipse width="356" height="356" originX="0.5" originY="0.5" name="Path"/>
                    <Stroke thickness="3" name="Stroke"><SolidColor colorValue="CCF0C419" name="Color"/></Stroke>
                </Shape>
                <Shape opacity="0.12" name="Aura outer" id="0:51">
                    <Ellipse width="410" height="410" originX="0.5" originY="0.5" name="Path"/>
                    <Stroke thickness="2" name="Stroke"><SolidColor colorValue="99F0C419" name="Color"/></Stroke>
                </Shape>
            </Node>
        </Node>

        <StateMachine name="Companion Machine" id="0:7">
            <!-- Product state: one blended loop for each assistant mode. -->
            <StateMachineLayer name="Mode" id="0:8">
                <AnyState x="20" y="-160" id="0:9">
                    <StateTransition stateToId="0:101" duration="220">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
                                    <DataBindContext sourcePathIds="0:400-0:410" propertyKey="637"/>
                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:501"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:102" duration="180">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
