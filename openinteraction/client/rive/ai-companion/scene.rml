                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:503"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:104" duration="140">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
                                    <DataBindContext sourcePathIds="0:400-0:410" propertyKey="637"/>
                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:504"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:105" duration="120">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
                                    <DataBindContext sourcePathIds="0:400-0:410" propertyKey="637"/>
                                </BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:505"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="800" y="-160"/>
                <EntryState>
                    <StateTransition stateToId="0:101"/>
                </EntryState>
                <AnimationState x="120" y="40" animationId="0:201" id="0:101"/>
                <AnimationState x="270" y="40" animationId="0:202" id="0:102"/>
                <AnimationState x="420" y="40" animationId="0:203" id="0:103"/>
                <AnimationState x="570" y="40" animationId="0:204" id="0:104"/>
                <AnimationState x="720" y="40" animationId="0:205" id="0:105"/>
            </StateMachineLayer>

            <!-- Ambient motion continues across all modes. -->
            <StateMachineLayer name="Aura" id="0:110">
                <AnyState x="20" y="220"/>
                <ExitState x="380" y="220"/>
                <EntryState><StateTransition stateToId="0:112"/></EntryState>
                <AnimationState x="190" y="220" animationId="0:206" id="0:112"/>
            </StateMachineLayer>

            <StateMachineLayer name="Blink" id="0:120">
                <AnyState x="20" y="360"/>
                <ExitState x="380" y="360"/>
                <EntryState><StateTransition stateToId="0:122"/></EntryState>
                <AnimationState x="190" y="360" animationId="0:207" id="0:122"/>
            </StateMachineLayer>

            <!-- A click reaction overlays whichever product state is active. -->
            <StateMachineLayer name="Reaction" id="0:130">
                <AnyState x="20" y="500" id="0:131">
                    <StateTransition stateToId="0:134" duration="70">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:400-0:413" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="520" y="500"/>
                <EntryState><StateTransition stateToId="0:133"/></EntryState>
                <AnimationState x="170" y="500" animationId="0:208" id="0:133"/>
                <AnimationState x="340" y="500" animationId="0:209" reset="true" id="0:134">
                    <StateTransition
                        stateToId="0:133"
                        duration="120"
                        enableExitTime="true"
                        exitTimeIsPercetange="true"
                        exitTime="100"
                    />
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Idle: uneven breathing with an occasional diagonal curiosity lean. -->
        <LinearAnimation loopValue="loop" duration="240" name="Idle" id="0:201">
            <KeyedObject objectId="0:21">
                <KeyedProperty property="x">
